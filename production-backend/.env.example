# Copy to .env and adjust. Never commit .env.
# Local dev (Docker): see ../docker-compose.dev.yml and ../.env.dev

DATABASE_URL=postgres://scorecard:scorecard_dev_pass@127.0.0.1:5432/salesscorecard_dev
NODE_ENV=development
JWT_SECRET=change_me
REFRESH_SECRET=change_me
PORT=3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002

# Optional: login when Postgres is not running (NODE_ENV=development only; never in production)
# DEV_AUTH_WITHOUT_DB=true
# DEV_AUTH_EMAIL=admin@dev.local
# DEV_AUTH_PASSWORD=password

# Optional: Dev AI (local only)
# AI_DEV_ENABLED=true
# OPENAI_API_KEY=
