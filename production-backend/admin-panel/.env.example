# PWA :3000 · API :3001 · Admin UI :3002 (see .env.development for PORT).
# Dev server calls the API at http://localhost:3001 by default (no proxy-only path needed).
# Optional: point the admin at another API while developing:
# REACT_APP_ADMIN_API_BASE_URL=https://your-api.example.com
# ADMIN_PROXY_TARGET=http://localhost:3001

